# =============================================================================
# Caddyfile — serve a SPA do redist-web
# -----------------------------------------------------------------------------
# O endereço vem da variável DOMAIN (com default :80 para dev local):
#   Produção : DOMAIN=redist.seudominio.com.br -> HTTPS automático (Let's Encrypt)
#   Dev local: DOMAIN=:80 (padrão)             -> HTTP puro
#
# try_files garante o fallback de SPA: qualquer rota (ex.: /login, /cadastro)
# cai em /index.html, e o React Router assume no cliente.
# =============================================================================

{
	# Default embutido para o email nunca ficar vazio (quebraria o parse).
	# Só é usado quando há um domínio real (ACME/Let's Encrypt).
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN::80} {
	root * /srv
	encode zstd gzip
	try_files {path} /index.html
	file_server

	# cache longo para os assets versionados (hash no nome); HTML nunca em cache.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}
