# =============================================================================
# Caddyfile — serve a SPA do redist-web e roteia a API/auth para a BFF
# -----------------------------------------------------------------------------
# DOMAIN (default :80 em dev):
#   Produção : DOMAIN=redist.seudominio.com.br -> HTTPS automático (Let's Encrypt)
#   Dev local: DOMAIN=:80                       -> HTTP puro
#
# Rotas:
#   /api/*, /auth/*  -> BFF (redist-bff): injeta o ApiToken e a sessão (cookie).
#   resto            -> arquivos da SPA, com fallback para /index.html (React Router).
# =============================================================================

{
	# Default embutido para o email nunca ficar vazio (quebraria o parse).
	# Só é usado quando há um domínio real (ACME/Let's Encrypt).
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN::80} {
	encode zstd gzip

	# API e autenticação -> BFF (na rede interna do compose).
	handle /api/* {
		reverse_proxy bff:3001
	}
	handle /auth/* {
		reverse_proxy bff:3001
	}

	# SPA estática + fallback de rotas do React Router.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Cache longo para assets versionados (hash no nome); HTML nunca em cache.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}
