# =============================================================================
# redist-web — variáveis para o Docker (copie para .env: cp .env.example .env)
# O .env é opcional em dev local (os defaults do compose já servem).
# =============================================================================

# Endereço servido pelo Caddy.
#   Dev local: :80 (HTTP puro)
#   Produção : um domínio real -> HTTPS automático via Let's Encrypt
DOMAIN=:80

# E-mail do ACME/Let's Encrypt (só usado com um domínio real).
ACME_EMAIL=

# URL da API embutida NO BUILD (Vite). Deixe vazio enquanto o front não
# consome a API. Ao conectar o login, aponte para a API pública, ex.:
#   VITE_API_URL=https://api.redist.seudominio.com.br
# Lembre: valores VITE_* vão para o bundle (públicos) — nunca coloque segredos.
VITE_API_URL=
