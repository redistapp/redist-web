# =============================================================================
# redist-web — variáveis para o Docker (copie para .env: cp .env.example .env)
# O compose usa defaults sensatos; em dev local muitas vezes o .env é opcional.
# =============================================================================

# --- Caddy / web ---
# Endereço servido pelo Caddy.
#   Dev local: :80 (HTTP puro)
#   Produção : um domínio real -> HTTPS automático via Let's Encrypt
DOMAIN=:80
# E-mail do ACME/Let's Encrypt (só usado com um domínio real).
ACME_EMAIL=
# Portas do host (útil para não colidir com a stack do redist-server na 80/443).
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# --- BFF (redist-bff) ---
# Onde está a API redist-server (a BFF injeta o ApiToken nas chamadas).
#   Mesma máquina, redist-server em Docker: http://host.docker.internal
#   Produção:                               https://api.seudominio.com.br
API_BASE_URL=http://host.docker.internal
# MESMO valor do API_TOKEN do redist-server (segredo — nunca vai ao navegador).
API_TOKEN=
# true apenas atrás de HTTPS (senão o navegador descarta o cookie de sessão).
COOKIE_SECURE=false
